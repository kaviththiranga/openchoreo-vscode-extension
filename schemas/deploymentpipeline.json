{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-openchoreo-kind": "DeploymentPipeline",
  "title": "OpenChoreo DeploymentPipeline",
  "description": "Defines promotion paths between environments for deploying component releases.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "openchoreo.dev/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "DeploymentPipeline"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the DeploymentPipeline"
        },
        "namespace": {
          "type": "string",
          "description": "Namespace (organization)",
          "x-openchoreo-ref": "Namespace"
        }
      },
      "required": ["name"]
    },
    "spec": {
      "type": "object",
      "description": "DeploymentPipeline specification",
      "additionalProperties": false,
      "properties": {
        "promotionPaths": {
          "type": "array",
          "description": "Promotion paths between environments",
          "items": {
            "type": "object",
            "required": ["sourceEnvironmentRef", "targetEnvironmentRefs"],
            "properties": {
              "sourceEnvironmentRef": {
                "type": "object",
                "description": "Reference to the source environment for this promotion path",
                "required": ["name"],
                "properties": {
                  "kind": {
                    "type": "string",
                    "description": "Kind of environment resource",
                    "enum": ["Environment"],
                    "default": "Environment"
                  },
                  "name": {
                    "type": "string",
                    "description": "Name of the source environment",
                    "minLength": 1,
                    "maxLength": 63,
                    "x-openchoreo-ref": "Environment"
                  }
                }
              },
              "targetEnvironmentRefs": {
                "type": "array",
                "description": "Target environments for promotion",
                "items": {
                  "type": "object",
                  "required": ["name"],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "description": "Kind of environment resource",
                      "enum": ["Environment"],
                      "default": "Environment"
                    },
                    "name": {
                      "type": "string",
                      "description": "Target environment name",
                      "x-openchoreo-ref": "Environment"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "required": ["apiVersion", "kind", "metadata"]
}

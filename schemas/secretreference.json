{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-openchoreo-kind": "SecretReference",
  "x-openchoreo-source": "openchoreo/openchoreo v1.3.3 config/crd/bases/openchoreo.dev_secretreferences.yaml",
  "title": "OpenChoreo SecretReference",
  "description": "SecretReference is the Schema for the secretreferences API.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "openchoreo.dev/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "SecretReference"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the SecretReference"
        },
        "namespace": {
          "type": "string",
          "description": "Namespace",
          "x-openchoreo-ref": "Namespace"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "name"
      ]
    },
    "spec": {
      "description": "SecretReferenceSpec defines the desired state of SecretReference.",
      "properties": {
        "data": {
          "description": "Data contains the mapping of secret keys to external secret references",
          "items": {
            "description": "SecretDataSource maps a secret key to an external secret reference.",
            "properties": {
              "remoteRef": {
                "description": "RemoteRef points to the external secret location",
                "properties": {
                  "key": {
                    "description": "Key is the path in the external secret store (e.g., \"secret/data/github/pat\")",
                    "minLength": 1,
                    "type": "string"
                  },
                  "property": {
                    "description": "Property is the specific field within the secret (e.g., \"token\")",
                    "type": "string"
                  },
                  "version": {
                    "description": "Version of the secret to fetch (provider-specific)",
                    "type": "string"
                  }
                },
                "required": [
                  "key"
                ],
                "type": "object",
                "additionalProperties": false
              },
              "secretKey": {
                "description": "SecretKey is the key name in the Kubernetes Secret",
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "remoteRef",
              "secretKey"
            ],
            "type": "object",
            "additionalProperties": false
          },
          "minItems": 1,
          "type": "array"
        },
        "refreshInterval": {
          "default": "1h",
          "description": "RefreshInterval specifies how often to reconcile/refresh the secret",
          "type": "string"
        },
        "targetPlane": {
          "description": "TargetPlane identifies the plane to whose external secret store the\nsecret value was pushed for this SecretReference. When unset, the\nsecret value may live in any external secret store reachable through\nthe references in spec.data.",
          "properties": {
            "kind": {
              "description": "Kind of the target plane resource.",
              "enum": [
                "WorkflowPlane",
                "ClusterWorkflowPlane",
                "DataPlane",
                "ClusterDataPlane"
              ],
              "type": "string"
            },
            "name": {
              "description": "Name of the target plane resource.",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object",
          "additionalProperties": false
        },
        "template": {
          "description": "Template defines the structure of the resulting Kubernetes Secret",
          "properties": {
            "metadata": {
              "description": "Metadata to add to the generated secret",
              "properties": {
                "annotations": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Annotations to add to the secret",
                  "type": "object"
                },
                "labels": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Labels to add to the secret",
                  "type": "object"
                }
              },
              "type": "object",
              "additionalProperties": false
            },
            "type": {
              "default": "Opaque",
              "description": "Type of the Kubernetes Secret (Opaque, kubernetes.io/dockerconfigjson, etc.)",
              "enum": [
                "Opaque",
                "kubernetes.io/dockerconfigjson",
                "kubernetes.io/dockercfg",
                "kubernetes.io/basic-auth",
                "kubernetes.io/ssh-auth",
                "kubernetes.io/tls",
                "bootstrap.kubernetes.io/token"
              ],
              "type": "string"
            }
          },
          "type": "object",
          "additionalProperties": false
        }
      },
      "required": [
        "data",
        "template"
      ],
      "type": "object",
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ]
}

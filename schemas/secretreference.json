{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-openchoreo-kind": "SecretReference",
  "title": "OpenChoreo SecretReference",
  "description": "Defines references to external secrets that are synced into the cluster.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "openchoreo.dev/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "SecretReference"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the SecretReference"
        },
        "namespace": {
          "type": "string",
          "description": "Namespace (organization)"
        }
      },
      "required": ["name"]
    },
    "spec": {
      "type": "object",
      "description": "SecretReference specification",
      "additionalProperties": false,
      "required": ["template", "data"],
      "properties": {
        "template": {
          "type": "object",
          "description": "Template for the Kubernetes Secret to be created",
          "properties": {
            "type": {
              "type": "string",
              "description": "Kubernetes secret type (e.g. Opaque, kubernetes.io/tls)"
            }
          }
        },
        "data": {
          "type": "array",
          "description": "Mapping of secret keys to external secret references",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "secretKey": {
                "type": "string",
                "description": "Key in the Kubernetes Secret"
              },
              "remoteRef": {
                "type": "object",
                "description": "Reference to the external secret",
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "Key in the external secret store"
                  },
                  "property": {
                    "type": "string",
                    "description": "Property within the external secret"
                  }
                }
              }
            }
          }
        },
        "refreshInterval": {
          "type": "string",
          "description": "How often to reconcile/refresh the secret (e.g. 1h)"
        }
      }
    }
  },
  "required": ["apiVersion", "kind", "metadata", "spec"]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-openchoreo-kind": "SecretReference",
  "title": "OpenChoreo SecretReference",
  "description": "Defines references to external secrets that are synced into the cluster.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "openchoreo.dev/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "SecretReference"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the SecretReference"
        },
        "namespace": {
          "type": "string",
          "description": "Namespace (organization)",
          "x-openchoreo-ref": "Namespace"
        }
      },
      "required": ["name"]
    },
    "spec": {
      "type": "object",
      "description": "SecretReference specification",
      "additionalProperties": false,
      "required": ["template", "data"],
      "properties": {
        "template": {
          "type": "object",
          "description": "Structure of the resulting Kubernetes Secret",
          "properties": {
            "type": {
              "type": "string",
              "description": "Type of the Kubernetes Secret",
              "enum": [
                "Opaque",
                "kubernetes.io/dockerconfigjson",
                "kubernetes.io/dockercfg",
                "kubernetes.io/basic-auth",
                "kubernetes.io/ssh-auth",
                "kubernetes.io/tls",
                "bootstrap.kubernetes.io/token"
              ],
              "default": "Opaque"
            },
            "metadata": {
              "type": "object",
              "description": "Additional metadata for the generated secret",
              "properties": {
                "annotations": {
                  "type": "object",
                  "description": "Annotations to add to the secret",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "labels": {
                  "type": "object",
                  "description": "Labels to add to the secret",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "data": {
          "type": "array",
          "description": "Mapping of secret keys to external secret references",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["secretKey", "remoteRef"],
            "properties": {
              "secretKey": {
                "type": "string",
                "description": "Key name in the Kubernetes Secret"
              },
              "remoteRef": {
                "type": "object",
                "description": "Points to a secret in an external secret store",
                "required": ["key"],
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "Path in the external secret store"
                  },
                  "property": {
                    "type": "string",
                    "description": "Specific field within the secret"
                  },
                  "version": {
                    "type": "string",
                    "description": "Version of the secret to fetch"
                  }
                }
              }
            }
          }
        },
        "refreshInterval": {
          "type": "string",
          "description": "How often to reconcile/refresh the secret (e.g. 1h)"
        }
      }
    }
  },
  "required": ["apiVersion", "kind", "metadata", "spec"]
}

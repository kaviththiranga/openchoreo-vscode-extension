{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-openchoreo-kind": "Trait",
  "title": "OpenChoreo Trait",
  "description": "A reusable capability that can be attached to components (e.g., persistence, autoscaling, monitoring, ingress).",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "openchoreo.dev/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "Trait"
    },
    "metadata": {
      "type": "object",
      "description": "Standard Kubernetes metadata",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the Trait"
        },
        "namespace": {
          "type": "string",
          "description": "Namespace (organization) this Trait belongs to"
        }
      },
      "required": ["name"]
    },
    "spec": {
      "type": "object",
      "description": "Trait specification",
      "properties": {
        "schema": {
          "type": "object",
          "description": "Schema definitions for trait parameters",
          "properties": {
            "types": {
              "type": "object",
              "description": "Reusable type definitions",
              "additionalProperties": true
            },
            "parameters": {
              "type": "object",
              "description": "Developer-facing trait parameters. Values use schema DSL format.",
              "additionalProperties": true
            },
            "envOverrides": {
              "type": "object",
              "description": "Per-environment override parameters",
              "additionalProperties": true
            }
          }
        },
        "resources": {
          "type": "array",
          "description": "Kubernetes resource templates generated by this trait",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier for this resource template"
              },
              "includeWhen": {
                "type": "string",
                "description": "CEL expression controlling conditional inclusion"
              },
              "forEach": {
                "type": "string",
                "description": "CEL expression for iteration"
              },
              "var": {
                "type": "string",
                "description": "Loop variable name"
              },
              "template": {
                "type": "object",
                "description": "Kubernetes resource template with CEL expressions",
                "additionalProperties": true
              }
            },
            "required": ["id", "template"]
          }
        }
      },
      "required": ["resources"]
    }
  },
  "required": ["apiVersion", "kind", "metadata", "spec"]
}

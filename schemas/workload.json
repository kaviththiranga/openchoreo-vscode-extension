{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-openchoreo-kind": "Workload",
  "title": "OpenChoreo Workload",
  "description": "The developer's application contract — what should run, not how it runs. Gets transformed into Kubernetes resources by ComponentType templates.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "openchoreo.dev/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "Workload"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the Workload"
        },
        "namespace": {
          "type": "string",
          "description": "Namespace (organization)",
          "x-openchoreo-ref": "Namespace"
        }
      },
      "required": ["name"]
    },
    "spec": {
      "type": "object",
      "description": "Workload specification",
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "object",
          "description": "Ownership linking to project and component",
          "properties": {
            "projectName": {
              "type": "string",
              "description": "Name of the owning project",
              "x-openchoreo-ref": "Project",
              "minLength": 1
            },
            "componentName": {
              "type": "string",
              "description": "Name of the owning component",
              "x-openchoreo-ref": "Component",
              "minLength": 1
            }
          },
          "required": ["projectName", "componentName"]
        },
        "container": {
          "type": "object",
          "description": "Container specification",
          "required": ["image"],
          "properties": {
            "image": {
              "type": "string",
              "description": "OCI container image (digest or tag)"
            },
            "command": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Container entrypoint override"
            },
            "args": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Container arguments"
            },
            "env": {
              "type": "array",
              "description": "Environment variables",
              "items": {
                "type": "object",
                "properties": {
                  "key": { "type": "string" },
                  "value": { "type": "string" },
                  "valueFrom": {
                    "type": "object",
                    "properties": {
                      "configurationGroupRef": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "key": { "type": "string" }
                        }
                      }
                    }
                  }
                },
                "required": ["key"]
              }
            },
            "files": {
              "type": "array",
              "description": "File mount configurations",
              "items": {
                "type": "object",
                "properties": {
                  "key": { "type": "string" },
                  "mountPath": { "type": "string" },
                  "value": { "type": "string" }
                },
                "required": ["key", "mountPath"]
              }
            }
          }
        },
        "endpoints": {
          "type": "object",
          "description": "Network endpoints exposed by the application",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["HTTP", "gRPC", "TCP", "UDP"],
                "description": "Protocol type"
              },
              "port": {
                "type": "integer",
                "description": "Port number"
              },
              "schema": {
                "type": "object",
                "description": "API schema definition",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["openapi", "graphql", "grpc", "asyncapi"]
                  },
                  "content": {
                    "type": "string",
                    "description": "Inline API schema content"
                  }
                }
              },
              "visibility": {
                "type": "array",
                "description": "Additional endpoint visibilities beyond implicit project visibility",
                "items": {
                  "type": "string",
                  "enum": ["organization", "public"]
                }
              }
            },
            "required": ["type", "port"]
          }
        },
        "dependencies": {
          "type": "object",
          "description": "Dependencies on other components' endpoints",
          "properties": {
            "endpoints": {
              "type": "array",
              "description": "List of endpoint dependencies",
              "items": {
                "type": "object",
                "properties": {
                  "componentRef": {
                    "type": "string",
                    "description": "Reference to the target component",
                    "x-openchoreo-ref": "Component"
                  },
                  "endpointRef": {
                    "type": "string",
                    "description": "Reference to the target endpoint"
                  }
                },
                "required": ["componentRef", "endpointRef"]
              }
            }
          }
        }
      },
      "required": ["owner"]
    }
  },
  "required": ["apiVersion", "kind", "metadata", "spec"]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-openchoreo-kind": "Workload",
  "title": "OpenChoreo Workload",
  "description": "The developer's application contract -- what should run, not how it runs. Gets transformed into Kubernetes resources by ComponentType templates.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "openchoreo.dev/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "Workload"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the Workload"
        },
        "namespace": {
          "type": "string",
          "description": "Namespace (organization)",
          "x-openchoreo-ref": "Namespace"
        }
      },
      "required": ["name"]
    },
    "spec": {
      "type": "object",
      "description": "Workload specification",
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "object",
          "description": "Owner reference for the workload",
          "required": ["projectName", "componentName"],
          "properties": {
            "projectName": {
              "type": "string",
              "description": "Name of the owning project",
              "x-openchoreo-ref": "Project",
              "minLength": 1
            },
            "componentName": {
              "type": "string",
              "description": "Name of the owning component",
              "x-openchoreo-ref": "Component",
              "minLength": 1
            }
          }
        },
        "container": {
          "type": "object",
          "description": "Container specification",
          "required": ["image"],
          "properties": {
            "image": {
              "type": "string",
              "description": "OCI image to run (digest or tag)"
            },
            "command": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Container entrypoint"
            },
            "args": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Container arguments"
            },
            "env": {
              "type": "array",
              "description": "Environment variables",
              "items": {
                "type": "object",
                "required": ["key"],
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "Variable key/name"
                  },
                  "value": {
                    "type": "string",
                    "description": "Variable value"
                  },
                  "valueFrom": {
                    "type": "object",
                    "description": "Value source reference",
                    "properties": {
                      "secretKeyRef": {
                        "type": "object",
                        "description": "Secret reference",
                        "properties": {
                          "name": {
                            "type": "string",
                            "description": "Secret name"
                          },
                          "key": {
                            "type": "string",
                            "description": "Secret key"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "files": {
              "type": "array",
              "description": "File mount configurations",
              "items": {
                "type": "object",
                "required": ["key", "mountPath"],
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "File key/name"
                  },
                  "mountPath": {
                    "type": "string",
                    "description": "Mount path in container"
                  },
                  "value": {
                    "type": "string",
                    "description": "File content"
                  },
                  "valueFrom": {
                    "type": "object",
                    "description": "Value source reference",
                    "properties": {
                      "secretKeyRef": {
                        "type": "object",
                        "description": "Secret reference",
                        "properties": {
                          "name": {
                            "type": "string",
                            "description": "Secret name"
                          },
                          "key": {
                            "type": "string",
                            "description": "Secret key"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "endpoints": {
          "type": "object",
          "description": "Named endpoint specifications",
          "additionalProperties": {
            "type": "object",
            "required": ["type", "port"],
            "properties": {
              "visibility": {
                "type": "array",
                "description": "Additional endpoint visibilities beyond implicit project visibility",
                "items": {
                  "type": "string",
                  "enum": ["project", "namespace", "internal", "external"]
                }
              },
              "type": {
                "type": "string",
                "description": "Protocol/technology of the endpoint",
                "enum": ["HTTP", "gRPC", "GraphQL", "Websocket", "TCP", "UDP"]
              },
              "port": {
                "type": "integer",
                "description": "Port exposed by the endpoint",
                "minimum": 1,
                "maximum": 65535
              },
              "targetPort": {
                "type": "integer",
                "description": "Container listening port (defaults to port)",
                "minimum": 1,
                "maximum": 65535
              },
              "displayName": {
                "type": "string",
                "description": "Human-readable name for the endpoint"
              },
              "basePath": {
                "type": "string",
                "description": "Base path of the API exposed via the endpoint"
              },
              "schema": {
                "type": "object",
                "description": "API definition schema",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "dependencies": {
          "type": "object",
          "description": "Dependencies on other components' endpoints",
          "properties": {
            "endpoints": {
              "type": "array",
              "description": "Endpoint connections to other components",
              "items": {
                "type": "object",
                "required": ["component", "name", "visibility", "envBindings"],
                "properties": {
                  "project": {
                    "type": "string",
                    "description": "Target component's project name. If empty, defaults to the same project as the consumer."
                  },
                  "component": {
                    "type": "string",
                    "description": "Target component name",
                    "x-openchoreo-ref": "Component",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "description": "Target endpoint name on the target component",
                    "minLength": 1
                  },
                  "visibility": {
                    "type": "string",
                    "description": "Visibility level at which this connection consumes the endpoint",
                    "enum": ["project", "namespace"]
                  },
                  "envBindings": {
                    "type": "object",
                    "description": "Maps resolved connection address components to environment variable names",
                    "properties": {
                      "address": {
                        "type": "string",
                        "description": "Env var name for the protocol-appropriate connection string"
                      },
                      "host": {
                        "type": "string",
                        "description": "Env var name for just the hostname"
                      },
                      "port": {
                        "type": "string",
                        "description": "Env var name for just the port number"
                      },
                      "basePath": {
                        "type": "string",
                        "description": "Env var name for just the base path"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "required": ["owner"]
    }
  },
  "required": ["apiVersion", "kind", "metadata", "spec"]
}

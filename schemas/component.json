{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-openchoreo-kind": "Component",
  "title": "OpenChoreo Component",
  "description": "An application unit (service, web app, scheduled task, etc.) that can be built and deployed.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "openchoreo.dev/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "Component"
    },
    "metadata": {
      "type": "object",
      "description": "Standard Kubernetes metadata",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the Component"
        },
        "namespace": {
          "type": "string",
          "description": "Namespace (organization) this Component belongs to",
          "x-openchoreo-ref": "Namespace"
        }
      },
      "required": ["name"]
    },
    "spec": {
      "type": "object",
      "description": "Component specification",
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "object",
          "description": "Ownership information for the component",
          "properties": {
            "projectName": {
              "type": "string",
              "description": "Name of the project this component belongs to",
              "x-openchoreo-ref": "Project",
              "minLength": 1
            }
          },
          "required": ["projectName"]
        },
        "componentType": {
          "type": "object",
          "description": "Reference to the ComponentType or ClusterComponentType",
          "required": ["name"],
          "properties": {
            "kind": {
              "type": "string",
              "description": "Kind of component type (ComponentType or ClusterComponentType)",
              "enum": ["ComponentType", "ClusterComponentType"],
              "default": "ComponentType"
            },
            "name": {
              "type": "string",
              "description": "Component type reference in format: {workloadType}/{componentTypeName}",
              "x-openchoreo-ref": "ComponentType"
            }
          }
        },
        "autoDeploy": {
          "type": "boolean",
          "description": "Whether to automatically deploy to default environment when created",
          "default": false
        },
        "autoBuild": {
          "type": "boolean",
          "description": "Whether to automatically trigger builds on code push"
        },
        "parameters": {
          "type": "object",
          "description": "ComponentType parameter values (schema defined by the referenced ComponentType)",
          "additionalProperties": true
        },
        "traits": {
          "type": "array",
          "description": "Trait instances attached to the component",
          "items": {
            "type": "object",
            "required": ["name", "instanceName"],
            "properties": {
              "kind": {
                "type": "string",
                "description": "Kind of trait resource (Trait for namespace-scoped, ClusterTrait for cluster-scoped)",
                "enum": ["Trait", "ClusterTrait"],
                "default": "Trait"
              },
              "name": {
                "type": "string",
                "description": "Trait template name",
                "x-openchoreo-ref": "Trait+ClusterTrait"
              },
              "instanceName": {
                "type": "string",
                "description": "Instance name for this trait attachment"
              },
              "parameters": {
                "type": "object",
                "description": "Trait parameters",
                "additionalProperties": true
              }
            }
          }
        },
        "workflow": {
          "type": "object",
          "description": "Workflow configuration for a component",
          "required": ["name"],
          "properties": {
            "kind": {
              "type": "string",
              "description": "Kind of referenced workflow resource (Workflow or ClusterWorkflow)",
              "enum": ["Workflow", "ClusterWorkflow"],
              "default": "ClusterWorkflow"
            },
            "name": {
              "type": "string",
              "description": "Referenced workflow resource name",
              "x-openchoreo-ref": "Workflow+ClusterWorkflow"
            },
            "parameters": {
              "type": "object",
              "description": "Developer-provided parameters for the referenced workflow",
              "additionalProperties": true
            }
          }
        }
      },
      "required": ["owner", "componentType"]
    }
  },
  "required": ["apiVersion", "kind", "metadata", "spec"]
}

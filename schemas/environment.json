{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-openchoreo-kind": "Environment",
  "title": "OpenChoreo Environment",
  "description": "Deployment target configuration bound to a DataPlane.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "openchoreo.dev/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "Environment"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the Environment"
        },
        "namespace": {
          "type": "string",
          "description": "Namespace (organization)",
          "x-openchoreo-ref": "Namespace"
        }
      },
      "required": ["name"]
    },
    "spec": {
      "type": "object",
      "description": "Environment specification",
      "additionalProperties": false,
      "properties": {
        "dataPlaneRef": {
          "type": "object",
          "description": "Reference to the DataPlane or ClusterDataPlane for this environment. If not specified, defaults to a DataPlane named \"default\" in the same namespace. Immutable once set.",
          "required": ["kind", "name"],
          "properties": {
            "kind": {
              "type": "string",
              "description": "Kind of data plane (DataPlane or ClusterDataPlane)",
              "enum": ["DataPlane", "ClusterDataPlane"]
            },
            "name": {
              "type": "string",
              "description": "Name of the data plane resource",
              "x-openchoreo-ref": "DataPlane"
            }
          }
        },
        "isProduction": {
          "type": "boolean",
          "description": "Whether this is a production environment",
          "default": false
        },
        "gateway": {
          "type": "object",
          "description": "Gateway configuration for this environment",
          "additionalProperties": true
        }
      }
    }
  },
  "required": ["apiVersion", "kind", "metadata", "spec"]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-openchoreo-kind": "ClusterTrait",
  "title": "OpenChoreo ClusterTrait",
  "description": "Cluster-scoped trait available across all namespaces.",
  "type": "object",
  "properties": {
    "apiVersion": { "type": "string", "const": "openchoreo.dev/v1alpha1" },
    "kind": { "type": "string", "const": "ClusterTrait" },
    "metadata": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the ClusterTrait" }
      },
      "required": ["name"]
    },
    "spec": {
      "type": "object",
      "description": "ClusterTrait specification",
      "properties": {
        "parameters": {
          "type": "object",
          "properties": {
            "openAPIV3Schema": { "type": "object", "additionalProperties": true }
          }
        },
        "environmentConfigs": {
          "type": "object",
          "properties": {
            "openAPIV3Schema": { "type": "object", "additionalProperties": true }
          }
        },
        "validations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule", "message"],
            "properties": {
              "rule": { "type": "string" },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        },
        "creates": {
          "type": "array",
          "description": "New Kubernetes resources to create",
          "items": {
            "type": "object",
            "required": ["template"],
            "properties": {
              "targetPlane": { "type": "string", "enum": ["dataplane", "observabilityplane"], "default": "dataplane" },
              "includeWhen": { "type": "string" },
              "forEach": { "type": "string" },
              "var": { "type": "string" },
              "template": { "type": "object", "additionalProperties": true }
            }
          }
        },
        "patches": {
          "type": "array",
          "description": "Modifications to existing resources",
          "items": {
            "type": "object",
            "required": ["target", "operations"],
            "properties": {
              "forEach": { "type": "string" },
              "var": { "type": "string" },
              "target": {
                "type": "object",
                "required": ["group", "version", "kind"],
                "properties": {
                  "group": { "type": "string" },
                  "version": { "type": "string" },
                  "kind": { "type": "string" },
                  "where": { "type": "string" }
                }
              },
              "targetPlane": { "type": "string", "enum": ["dataplane", "observabilityplane"], "default": "dataplane" },
              "operations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["op", "path"],
                  "properties": {
                    "op": { "type": "string", "enum": ["add", "replace", "remove"] },
                    "path": { "type": "string" },
                    "value": {}
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "required": ["apiVersion", "kind", "metadata"]
}

{
  "OpenChoreo ComponentType": {
    "prefix": "oc-componenttype",
    "description": "Scaffold a new OpenChoreo ComponentType CRD",
    "body": [
      "apiVersion: openchoreo.dev/v1alpha1",
      "kind: ComponentType",
      "metadata:",
      "  name: ${1:my-component-type}",
      "  namespace: ${2:default}",
      "spec:",
      "  workloadType: ${3|deployment,statefulset,cronjob,job,proxy|}",
      "",
      "  allowedWorkflows:",
      "    - name: ${4:docker}",
      "",
      "  schema:",
      "    types: {}",
      "    parameters:",
      "      ${5:replicas}:",
      "        type: \"integer | default=1\"",
      "    envOverrides: {}",
      "",
      "  resources:",
      "    - id: ${3}",
      "      template:",
      "        apiVersion: apps/v1",
      "        kind: Deployment",
      "        metadata:",
      "          name: \"\\${metadata.name}\"",
      "        spec:",
      "          replicas: \"\\${parameters.${5}}\"",
      "          selector:",
      "            matchLabels:",
      "              app: \"\\${metadata.name}\"",
      "          template:",
      "            metadata:",
      "              labels:",
      "                app: \"\\${metadata.name}\"",
      "            spec:",
      "              containers:",
      "                - name: main",
      "                  image: \"\\${workload.containers.main.image}\"",
      "$0"
    ]
  },
  "OpenChoreo Trait": {
    "prefix": "oc-trait",
    "description": "Scaffold a new OpenChoreo Trait CRD",
    "body": [
      "apiVersion: openchoreo.dev/v1alpha1",
      "kind: Trait",
      "metadata:",
      "  name: ${1:my-trait}",
      "  namespace: ${2:default}",
      "spec:",
      "  schema:",
      "    parameters:",
      "      ${3:enabled}:",
      "        type: \"boolean | default=true\"",
      "    envOverrides: {}",
      "",
      "  resources:",
      "    - id: ${4:trait-resource}",
      "      includeWhen: \"\\${parameters.${3}}\"",
      "      template:",
      "        apiVersion: v1",
      "        kind: ConfigMap",
      "        metadata:",
      "          name: \"\\${metadata.name}-${1}\"",
      "        data:",
      "          config: \"\\${parameters.${3}}\"",
      "$0"
    ]
  },
  "OpenChoreo Workflow": {
    "prefix": "oc-workflow",
    "description": "Scaffold a new OpenChoreo Workflow (ComponentWorkflow) CRD",
    "body": [
      "apiVersion: openchoreo.dev/v1alpha1",
      "kind: ComponentWorkflow",
      "metadata:",
      "  name: ${1:docker}",
      "  namespace: ${2:default}",
      "spec:",
      "  systemParameters:",
      "    repository:",
      "      url: \"\"",
      "      revision:",
      "        branch: \"main\"",
      "      appPath: \".\"",
      "",
      "  schema:",
      "    parameters:",
      "      ${3:dockerfile}:",
      "        type: \"string | default=Dockerfile\"",
      "",
      "  argoWorkflowRef:",
      "    name: ${4:docker-build}",
      "    namespace: ${5:argo-workflows}",
      "$0"
    ]
  },
  "OpenChoreo Component": {
    "prefix": "oc-component",
    "description": "Scaffold a new OpenChoreo Component CRD",
    "body": [
      "apiVersion: openchoreo.dev/v1alpha1",
      "kind: Component",
      "metadata:",
      "  name: ${1:my-component}",
      "  namespace: ${2:default}",
      "spec:",
      "  owner:",
      "    projectName: ${3:default}",
      "",
      "  componentType: ${4:service}",
      "",
      "  workflow:",
      "    name: ${5:docker}",
      "    parameters:",
      "      dockerfile: Dockerfile",
      "    systemParameters:",
      "      repository:",
      "        url: ${6:https://github.com/org/repo}",
      "        revision:",
      "          branch: main",
      "        appPath: \".\"",
      "",
      "  parameters:",
      "    replicas: 1",
      "",
      "  traits: []",
      "",
      "  autoDeploy: true",
      "$0"
    ]
  },
  "OpenChoreo Environment": {
    "prefix": "oc-environment",
    "description": "Scaffold a new OpenChoreo Environment CRD",
    "body": [
      "apiVersion: openchoreo.dev/v1alpha1",
      "kind: Environment",
      "metadata:",
      "  name: ${1:development}",
      "  namespace: ${2:default}",
      "spec:",
      "  dataPlaneRef: ${3:default}",
      "  isProduction: ${4|false,true|}",
      "  gateway:",
      "    dnsPrefix: ${5:api}",
      "$0"
    ]
  },
  "OpenChoreo DataPlane": {
    "prefix": "oc-dataplane",
    "description": "Scaffold a new OpenChoreo DataPlane CRD",
    "body": [
      "apiVersion: openchoreo.dev/v1alpha1",
      "kind: DataPlane",
      "metadata:",
      "  name: ${1:default}",
      "  namespace: ${2:default}",
      "spec:",
      "  kubernetesCluster:",
      "    server: ${3:https://kubernetes.default.svc}",
      "    tls:",
      "      ca:",
      "        secretRef:",
      "          name: ${4:cluster-ca}",
      "          key: ca.crt",
      "    auth:",
      "      bearerToken:",
      "        secretRef:",
      "          name: ${5:cluster-token}",
      "          key: token",
      "  gateway:",
      "    publicVirtualHost: ${6:api.example.com}",
      "    organizationVirtualHost: ${7:internal.example.com}",
      "$0"
    ]
  },
  "OpenChoreo Project": {
    "prefix": "oc-project",
    "description": "Scaffold a new OpenChoreo Project CRD",
    "body": [
      "apiVersion: openchoreo.dev/v1alpha1",
      "kind: Project",
      "metadata:",
      "  name: ${1:my-project}",
      "  namespace: ${2:default}",
      "spec:",
      "  deploymentPipelineRef: ${3:standard-pipeline}",
      "$0"
    ]
  },
  "OpenChoreo DeploymentPipeline": {
    "prefix": "oc-deploymentpipeline",
    "description": "Scaffold a new OpenChoreo DeploymentPipeline CRD",
    "body": [
      "apiVersion: openchoreo.dev/v1alpha1",
      "kind: DeploymentPipeline",
      "metadata:",
      "  name: ${1:standard-pipeline}",
      "  namespace: ${2:default}",
      "spec:",
      "  stages:",
      "    - name: ${3:development}",
      "      environmentRef: ${3}",
      "    - name: ${4:production}",
      "      environmentRef: ${4}",
      "$0"
    ]
  },
  "OpenChoreo Workload": {
    "prefix": "oc-workload",
    "description": "Scaffold a new OpenChoreo Workload CRD",
    "body": [
      "apiVersion: openchoreo.dev/v1alpha1",
      "kind: Workload",
      "metadata:",
      "  name: ${1:my-workload}",
      "  namespace: ${2:default}",
      "spec:",
      "  owner:",
      "    projectName: ${3:default}",
      "    componentName: ${4:my-component}",
      "",
      "  containers:",
      "    main:",
      "      image: \"${5:registry/app:latest}\"",
      "      env:",
      "        - key: ${6:PORT}",
      "          value: \"${7:8080}\"",
      "",
      "  endpoints:",
      "    http:",
      "      type: HTTP",
      "      port: ${7}",
      "$0"
    ]
  }
}

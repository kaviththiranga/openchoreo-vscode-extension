    "menus": {
      "editor/title": [
        {
          "command": "openchoreo.compareWithCluster",
          "when": "openchoreo.gitopsRepository && resourceScheme == file && resourceLangId == yaml",
          "group": "navigation@90"
        }
      ],
      "view/title": [],
      "webview/context": [
        {
          "command": "openchoreo.createComponent",
          "when": "webviewId == openchoreo.sidebar && nodeType == project && isCreatable",
          "group": "1_create"
        },
        {
          "command": "openchoreo.createChildResource",
          "when": "webviewId == openchoreo.sidebar && nodeType == 'infra-category' && isCreatable",
          "group": "1_create"
        },
        {
          "command": "openchoreo.generateRelease",
          "when": "webviewId == openchoreo.sidebar && nodeType == component && isEditable",
          "group": "1_actions"
        },
        {
          "command": "openchoreo.triggerBuild",
          "when": "webviewId == openchoreo.sidebar && nodeType == component && isEditable && isBuildable",
          "group": "1_actions"
        },
        {
          "command": "openchoreo.triggerBuildWithParams",
          "when": "webviewId == openchoreo.sidebar && nodeType == component && isEditable && isBuildable",
          "group": "1_actions"
        },
        {
          "command": "openchoreo.runWorkflow",
          "when": "webviewId == openchoreo.sidebar && nodeType == workflow && isEditable",
          "group": "1_actions"
        },
        {
          "command": "openchoreo.runWorkflow",
          "when": "webviewId == openchoreo.sidebar && nodeType == 'cluster-workflow' && isEditable",
          "group": "1_actions"
        },
        {
          "command": "openchoreo.openResource",
          "when": "webviewId == openchoreo.sidebar && isEditable",
          "group": "2_open"
        },
        {
          "command": "openchoreo.openK8sDefinition",
          "when": "webviewId == openchoreo.sidebar && nodeType == 'k8s-resource' || webviewId == openchoreo.sidebar && nodeType == 'k8s-pod'",
          "group": "2_open"
        },
        {
          "command": "openchoreo.viewWorkflowRunLogs",
          "when": "webviewId == openchoreo.sidebar && nodeType == 'workflow-run'",
          "group": "2_observe"
        },
        {
          "command": "openchoreo.viewWorkflowRunEvents",
          "when": "webviewId == openchoreo.sidebar && nodeType == 'workflow-run'",
          "group": "2_observe"
        },
        {
          "command": "openchoreo.viewStepLogs",
          "when": "webviewId == openchoreo.sidebar && nodeType == 'workflow-run-step'",
          "group": "2_observe"
        },
        {
          "command": "openchoreo.viewStepEvents",
          "when": "webviewId == openchoreo.sidebar && nodeType == 'workflow-run-step'",
          "group": "2_observe"
        },
        {
          "command": "openchoreo.viewK8sResourceLogs",
          "when": "webviewId == openchoreo.sidebar && nodeType == 'k8s-pod'",
          "group": "2_observe"
        },
        {
          "command": "openchoreo.viewK8sResourceEvents",
          "when": "webviewId == openchoreo.sidebar && nodeType == 'k8s-resource' || webviewId == openchoreo.sidebar && nodeType == 'k8s-pod'",
          "group": "2_observe"
        },
        {
          "command": "openchoreo.promoteBinding",
          "when": "webviewId == openchoreo.sidebar && isPromotable",
          "group": "1_actions"
        },
        {
          "command": "openchoreo.deployToEnv",
          "when": "webviewId == openchoreo.sidebar && isDeployable",
          "group": "1_actions"
        },
        {
          "command": "openchoreo.deployRelease",
          "when": "webviewId == openchoreo.sidebar && nodeType == 'component-release'",
          "group": "1_actions"
        },
        {
          "command": "openchoreo.deleteResource",
          "when": "webviewId == openchoreo.sidebar && isDeletable",
          "group": "3_destructive"
        },
        {
          "command": "openchoreo.troubleshootWithCopilot",
          "when": "webviewId == openchoreo.sidebar && nodeType == 'workflow-run' && statusPhase =~ /^(Failed|Error)$/ || webviewId == openchoreo.sidebar && nodeType == 'release-binding'",
          "group": "4_chat@0"
        },
        {
          "command": "openchoreo.addToChat",
          "when": "webviewId == openchoreo.sidebar && nodeType && nodeType != 'no-connection' && nodeType != empty && nodeType != 'component-category' && nodeType != 'infra-category' && nodeType != 'resource-category'",
          "group": "4_chat"
        },
        {
          "command": "openchoreo.addYamlToChat",
          "when": "webviewId == openchoreo.sidebar && nodeType && nodeType != 'no-connection' && nodeType != empty && nodeType != 'component-category' && nodeType != 'infra-category' && nodeType != 'resource-category'",
          "group": "4_chat"
        },
        {
          "command": "openchoreo.viewRuntimeLogs",
          "when": "webviewId == openchoreo.sidebar && nodeType == component || webviewId == openchoreo.sidebar && nodeType == 'release-binding'",
          "group": "2_observe"
        },
        {
          "command": "openchoreo.openShell",
          "when": "webviewId == openchoreo.sidebar && nodeType == component || webviewId == openchoreo.sidebar && nodeType == 'release-binding'",
          "group": "2_observe"
        },
        {
          "command": "openchoreo.runScheduledTaskNow",
          "when": "webviewId == openchoreo.sidebar && nodeType == 'release-binding'",
          "group": "3_deploy"
        },
        {
          "command": "openchoreo.compareWithRepository",
          "when": "webviewId == openchoreo.sidebar && openchoreo.gitopsRepository && isEditable",
          "group": "2_observe@9"
        },
        {
          "command": "openchoreo.compareWithRepository",
          "when": "webviewId == openchoreo.sidebar && openchoreo.gitopsRepository && isGitOpsManaged",
          "group": "2_observe@9"
        },
        {
          "command": "openchoreo.compareWithRepository",
          "when": "webviewId == openchoreo.sidebar && openchoreo.gitopsRepository && nodeType == 'component-release'",
          "group": "2_observe@9"
        },
        {
          "command": "openchoreo.cloneSource",
          "when": "webviewId == openchoreo.sidebar && nodeType == component && isBuildable",
          "group": "0_source"
        },
        {
          "command": "openchoreo.compareReleases",
          "when": "webviewId == openchoreo.sidebar && nodeType == 'component-release' || webviewId == openchoreo.sidebar && nodeType == 'release-binding' && isPromotable",
          "group": "2_observe@8"
        },
        {
          "command": "openchoreo.rollbackBinding",
          "when": "webviewId == openchoreo.sidebar && nodeType == 'release-binding' && isPromotable",
          "group": "1_actions@9"
        }
      ],
      "view/item/context": [],
      "explorer/context": [
        {
          "command": "openchoreo.runLocally",
          "when": "resourceFilename =~ /^workload\\.ya?ml$/ || explorerResourceIsFolder && resourceFilename == .openchoreo",
          "group": "openchoreo"
        },
        {
          "command": "openchoreo.compareWithCluster",
          "when": "resourceExtname =~ /^\\.ya?ml$/",
          "group": "openchoreo"
        },
        {
          "command": "openchoreo.debugLocally",
          "when": "resourceFilename =~ /^workload\\.ya?ml$/ || explorerResourceIsFolder && resourceFilename == .openchoreo",
          "group": "openchoreo"
        }
      ],
      "commandPalette": [
        {
          "command": "openchoreo.troubleshootWithCopilot",
          "when": "false"
        },
        {
          "command": "openchoreo.fixWithCopilot",
          "when": "false"
        },
        {
          "command": "openchoreo.compareWithRepository",
          "when": "false"
        },
        {
          "command": "openchoreo.linkedComponentActions",
          "when": "openchoreo.linkedComponent"
        },
        {
          "command": "openchoreo.cloneSource",
          "when": "false"
        },
        {
          "command": "openchoreo.compareReleases",
          "when": "false"
        },
        {
          "command": "openchoreo.rollbackBinding",
          "when": "false"
        },
        {
          "command": "openchoreo.buildCommit",
          "when": "openchoreo.linkedComponent"
        },
        {
          "command": "openchoreo.manageTunnels",
          "when": "openchoreo.tunnelsOpen"
        }
      ],
      "editor/context": [
        {
          "command": "openchoreo.compareWithCluster",
          "when": "resourceScheme == file && resourceLangId == yaml",
          "group": "openchoreo@1"
        }
      ]
    },
    "configuration": {
      "title": "OpenChoreo",
      "properties": {
        "openchoreo.configPath": {
          "type": "string",
          "default": "",
          "description": "Path to occ CLI config file. Defaults to ~/.openchoreo/config"
        },
        "openchoreo.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the occ CLI binary. When set, overrides both the extension-managed download and the system PATH lookup. Useful for pointing at a custom build."
        },
        "openchoreo.autoRefresh": {
          "type": "boolean",
          "default": false,
          "description": "Automatically refresh resource tree on changes"
        },
        "openchoreo.autoRefreshInterval": {
          "type": "number",
          "default": 30,
          "description": "Auto-refresh interval in seconds"
        },
        "openchoreo.mcp.toolsets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "namespace",
            "project",
            "component",
            "resource",
            "deployment",
            "build",
            "endpoint"
          ],
          "markdownDescription": "Control-plane toolsets offered by the `openchoreo-cp` MCP server. Known toolsets: `namespace`, `project`, `component`, `resource`, `deployment`, `build`, `endpoint` (1.4+), `pe`. An empty list offers every toolset the server enables. Keep the list short: chat requests are limited to 128 tools."
        },
        "openchoreo.mcp.platformEngineerTools": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Also register `openchoreo-pe`, an MCP server with the platform-engineer toolset (environments, pipelines, component types, traits, workflows, planes, authorization). Tools you are not permitted to use are hidden."
        },
        "openchoreo.mcp.observability": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Register the observer (`openchoreo-obs`: logs, metrics, traces, alerts) and SRE agent (`openchoreo-sre`: root-cause reports) MCP servers found through the current namespace's environments."
        },
        "openchoreo.mcp.observerUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Observer base URL for `openchoreo-obs`, e.g. `https://observer.example.com`. Overrides discovery; set it when your role cannot read observability planes."
        },
        "openchoreo.mcp.sreAgentUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "SRE agent base URL for `openchoreo-sre`. Overrides discovery."
        },
        "openchoreo.ai.bundledSkills": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer the [OpenChoreo agent skills](https://github.com/openchoreo/skills) bundled with the extension to chat agents. Turn off if you install the OpenChoreo agent plugin directly, to avoid duplicate skills."
        },
        "openchoreo.addCliToTerminalPath": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Add the occ CLI the extension uses to the `PATH` of integrated terminals, so commands run by agents and skills find it."
        },
        "openchoreo.gitops.mode": {
          "type": "string",
          "enum": [
            "detect",
            "all",
            "off"
          ],
          "default": "detect",
          "enumDescriptions": [
            "Treat resources that carry Flux or Argo CD labels as GitOps-managed.",
            "Treat every OpenChoreo resource as GitOps-managed (manifests applied by CI or another tool leave no labels).",
            "Never warn before changing resources through the API."
          ],
          "markdownDescription": "Which resources are managed through GitOps. Saving, applying, promoting, deploying or deleting a GitOps-managed resource through the API asks first, and offers to make the change in the GitOps repository open in the window instead."
        },
        "openchoreo.gitops.allowDirectChanges": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer **Continue Anyway** when changing a GitOps-managed resource through the API. Turn off to allow changes only through the GitOps repository."
        },
        "openchoreo.builds.followAfterPush": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "After you push a linked component's branch, follow the build auto-build starts for the commit in the status bar (or offer to build it when auto-build is off)."
        },
        "openchoreo.localDev.keepTunnelsOpen": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Keep the `occ remote` tunnels a debug session opened after it ends, so the next session starts faster. Close them from the status bar."
        }
      }
    },
    "snippets": [],
    "chatSkills": [
      {
        "path": "./skills/migrate-to-openchoreo/SKILL.md",
        "when": "config.openchoreo.ai.bundledSkills"
      },
      {
        "path": "./skills/openchoreo-developer/SKILL.md",
        "when": "config.openchoreo.ai.bundledSkills"
      },
      {
        "path": "./skills/openchoreo-developer-gitops/SKILL.md",
        "when": "config.openchoreo.ai.bundledSkills"
      },
      {
        "path": "./skills/openchoreo-platform-engineer/SKILL.md",
        "when": "config.openchoreo.ai.bundledSkills"
      },
      {
        "path": "./skills/openchoreo-platform-engineer-gitops/SKILL.md",
        "when": "config.openchoreo.ai.bundledSkills"
      },
      {
        "path": "./skills/openchoreo-setup/SKILL.md",
        "when": "config.openchoreo.ai.bundledSkills"
      }
    ],
    "chatInstructions": [
      {
        "path": "./resources/ai/openchoreo-resources.instructions.md"
      }
    ],
    "chatAgents": [
      {
        "path": "./resources/ai/agents/openchoreo-developer.agent.md"
      },
      {
        "path": "./resources/ai/agents/openchoreo-platform-engineer.agent.md",
        "when": "config.openchoreo.mcp.platformEngineerTools"
      }
    ],
    "languageModelTools": [
      {
        "name": "openchoreo_validate_yaml",
        "displayName": "Validate OpenChoreo YAML",
        "toolReferenceName": "openchoreoValidate",
        "canBeReferencedInPrompt": true,
        "icon": "$(check-all)",
        "tags": [
          "openchoreo"
        ],
        "userDescription": "Check OpenChoreo resource YAML against the CRD schemas and references, as the editor does.",
        "modelDescription": "Validates OpenChoreo resource YAML (apiVersion openchoreo.dev/v1alpha1) with the OpenChoreo extension's language server: schema errors, unknown or misspelled fields, invalid values, and references to platform resources that don't exist. Pass filePath (absolute path; unsaved editor changes are included) or content (YAML text; several documents separated by --- are allowed). Returns each problem with line, column and severity, or says there are none. Run it after writing or editing OpenChoreo YAML and before applying it or creating the resource through MCP.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "filePath": {
              "type": "string",
              "description": "Absolute path of a YAML file to validate."
            },
            "content": {
              "type": "string",
              "description": "YAML text to validate instead of a file."
            }
          }
        }
      },
      {
        "name": "openchoreo_get_context",
        "displayName": "Get OpenChoreo Context",
        "toolReferenceName": "openchoreoContext",
        "canBeReferencedInPrompt": true,
        "icon": "$(info)",
        "tags": [
          "openchoreo"
        ],
        "userDescription": "The current OpenChoreo session: control plane, namespace, project, server version and MCP servers.",
        "modelDescription": "Returns the user's current OpenChoreo session from the occ CLI and the editor: whether they are signed in, the control plane URL, occ context, namespace, default project and component, whether authentication is enabled, the control plane version and which version-dependent features it has (project types 1.3+, release lines 1.4+), the OpenChoreo MCP servers registered in this editor, and the OpenChoreo resource in the active editor. Call it first to learn which namespace and project to work in and which features to use.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "openchoreo_scaffold_resource",
        "displayName": "Scaffold OpenChoreo Resource",
        "toolReferenceName": "openchoreoScaffold",
        "canBeReferencedInPrompt": true,
        "icon": "$(new-file)",
        "tags": [
          "openchoreo"
        ],
        "userDescription": "A starting YAML for an OpenChoreo kind that matches the connected server's version.",
        "modelDescription": "Returns starter YAML for an OpenChoreo resource kind (for example Project, Component, Workload, ComponentType, Trait, Environment, DeploymentPipeline, ProjectType), matching the connected control plane's version and filled with the current namespace and project. Use it as the starting point when writing a new resource file, then edit the placeholder names and validate the result with openchoreo_validate_yaml.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "description": "Resource kind, e.g. Component or ClusterTrait."
            },
            "namespace": {
              "type": "string",
              "description": "OpenChoreo namespace; defaults to the current one."
            },
            "project": {
              "type": "string",
              "description": "Project; defaults to the current one."
            }
          },
          "required": [
            "kind"
          ]
        }
      }
    ]
  },
  "scripts": {
    "build": "node scripts/sync-skills.mjs && esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "dev": "pnpm build --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "demo:capture": "node scripts/capture-demo.mjs",
    "generate:icons": "fantasticon && node scripts/update-icon-font.mjs",
    "clean": "rm -rf dist out",
    "prepackage": "node scripts/sync-skills.mjs --required && cp -r ../../schemas ./schemas && mkdir -p ./language-server/dist && cp ../language-server/dist/server.js ./language-server/dist/server.js && mkdir -p ./webview-ui/dist && cp ../webview-ui/dist/* ./webview-ui/dist/",
    "package": "pnpm build && vsce package --no-dependencies --allow-missing-repository --skip-license",
    "postpackage": "rm -rf ./schemas ./language-server ./webview-ui"
  },
  "dependencies": {
    "@openchoreo/openchoreo-client-node": "^1.3.3",
    "@vercel/frameworks": "^3.24",
    "dockerfile-ast": "^0.7",
    "fast-xml-parser": "^5.7",
    "openapi-fetch": "0.13.8",
    "package-manager-detector": "^1.6",
    "vscode-languageclient": "^9.0.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "fantasticon": "^4.1.0",
    "mocha": "^11.7.1",
    "playwright-core": "1.64.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}

{
  "name": "openchoreo-unofficial",
  "displayName": "OpenChoreo for VS Code",
  "description": "Build, deploy and operate on the OpenChoreo developer platform from VS Code: resource explorer, CRD editing with validation and completions, run locally against real environments, runtime logs, and AI: OpenChoreo MCP servers, agent skills, custom agents and chat tools for Copilot.",
  "version": "0.3.0",
  "publisher": "KavithLokuhewage",
  "license": "Apache-2.0",
  "icon": "resources/openchoreo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaviththiranga/openchoreo-vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/kaviththiranga/openchoreo-vscode-extension/issues"
  },
  "homepage": "https://github.com/kaviththiranga/openchoreo-vscode-extension#readme",
  "occVersion": "v1.3.3",
  "openchoreoSkills": {
    "repository": "openchoreo/skills",
    "ref": "cefd81bc16b79bd2de0f6284e6fa06d6c15825b7"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "openchoreo",
    "kubernetes",
    "crd",
    "yaml",
    "platform-engineering",
    "mcp",
    "copilot",
    "ai",
    "agent-skills"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "onFileSystem:openchoreo",
    "onView:openchoreo.sidebar"
  ],
  "main": "./dist/extension.js",

{
  "name": "openchoreo",
  "displayName": "OpenChoreo",
  "description": "IDE-native tooling for the OpenChoreo developer platform — CRD editing, resource explorer, and platform workflows",
  "version": "0.1.0",
  "publisher": "openchoreo",
  "license": "Apache-2.0",
  "icon": "resources/openchoreo.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "openchoreo",
    "kubernetes",
    "crd",
    "yaml",
    "platform-engineering"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "onFileSystem:openchoreo",
    "onView:openchoreo.sidebar"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "icons": {
      "openchoreo-visibility": {
        "description": "Observability Plane",
        "default": {
          "fontPath": "resources/openchoreo-icons.woff2",
          "fontCharacter": ""
        }
      },
      "openchoreo-storage": {
        "description": "Workload",
        "default": {
          "fontPath": "resources/openchoreo-icons.woff2",
          "fontCharacter": ""
        }
      },
      "openchoreo-security": {
        "description": "Role",
        "default": {
          "fontPath": "resources/openchoreo-icons.woff2",
          "fontCharacter": ""
        }
      },
      "openchoreo-play-circle-outline": {
        "description": "Workflow",
        "default": {
          "fontPath": "resources/openchoreo-icons.woff2",
          "fontCharacter": ""
        }
      },
      "openchoreo-memory": {
        "description": "Component",
        "default": {
          "fontPath": "resources/openchoreo-icons.woff2",
          "fontCharacter": ""
        }
      },
      "openchoreo-logo": {
        "description": "OpenChoreo logo",
        "default": {
          "fontPath": "resources/openchoreo-icons.woff2",
          "fontCharacter": ""
        }
      },
      "openchoreo-link": {
        "description": "Role Binding",
        "default": {
          "fontPath": "resources/openchoreo-icons.woff2",
          "fontCharacter": ""
        }
      },
      "openchoreo-extension": {
        "description": "Trait",
        "default": {
          "fontPath": "resources/openchoreo-icons.woff2",
          "fontCharacter": ""
        }
      },
      "openchoreo-dns": {
        "description": "Data Plane",
        "default": {
          "fontPath": "resources/openchoreo-icons.woff2",
          "fontCharacter": ""
        }
      },
      "openchoreo-dashboard": {
        "description": "Project",
        "default": {
          "fontPath": "resources/openchoreo-icons.woff2",
          "fontCharacter": ""
        }
      },
      "openchoreo-cloud": {
        "description": "Environment",
        "default": {
          "fontPath": "resources/openchoreo-icons.woff2",
          "fontCharacter": ""
        }
      },
      "openchoreo-category": {
        "description": "Component Type",
        "default": {
          "fontPath": "resources/openchoreo-icons.woff2",
          "fontCharacter": ""
        }
      },
      "openchoreo-build": {
        "description": "Workflow Plane",
        "default": {
          "fontPath": "resources/openchoreo-icons.woff2",
          "fontCharacter": ""
        }
      },
      "openchoreo-apartment": {
        "description": "Namespace",
        "default": {
          "fontPath": "resources/openchoreo-icons.woff2",
          "fontCharacter": ""
        }
      },
      "openchoreo-account-tree": {
        "description": "Deployment Pipeline",
        "default": {
          "fontPath": "resources/openchoreo-icons.woff2",
          "fontCharacter": ""
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "openchoreo",
        "label": "OpenChoreo"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openchoreo",
          "title": "OpenChoreo",
          "icon": "resources/openchoreo.svg"
        }
      ]
    },
    "views": {
      "openchoreo": [
        {
          "id": "openchoreo.sidebar",
          "type": "webview",
          "name": "Explorer"
        }
      ]
    },
    "commands": [
      {
        "command": "openchoreo.refreshResources",
        "title": "Refresh Resources",
        "category": "OpenChoreo",
        "icon": "$(refresh)"
      },
      {
        "command": "openchoreo.switchContext",
        "title": "Switch Context",
        "category": "OpenChoreo"
      },
      {
        "command": "openchoreo.login",
        "title": "Login (via occ CLI)",
        "category": "OpenChoreo"
      },
      {
        "command": "openchoreo.openResource",
        "title": "Open Resource YAML",
        "category": "OpenChoreo"
      },
      {
        "command": "openchoreo.refreshInfrastructure",
        "title": "Refresh Infrastructure",
        "category": "OpenChoreo",
        "icon": "$(refresh)"
      },
      {
        "command": "openchoreo.deleteResource",
        "title": "Delete",
        "category": "OpenChoreo",
        "icon": "$(trash)"
      },
      {
        "command": "openchoreo.applyResource",
        "title": "Apply Resource to Cluster",
        "category": "OpenChoreo",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "openchoreo.createDevResource",
        "title": "Create Resource",
        "category": "OpenChoreo",
        "icon": "$(add)"
      },
      {
        "command": "openchoreo.createInfraResource",
        "title": "Create Resource",
        "category": "OpenChoreo",
        "icon": "$(add)"
      },
      {
        "command": "openchoreo.createClusterResource",
        "title": "Create Cluster Resource",
        "category": "OpenChoreo",
        "icon": "$(add)"
      },
      {
        "command": "openchoreo.selectNamespace",
        "title": "Select Namespace",
        "category": "OpenChoreo",
        "icon": "$(openchoreo-apartment)"
      },
      {
        "command": "openchoreo.createChildResource",
        "title": "Create",
        "category": "OpenChoreo",
        "icon": "$(add)"
      },
      {
        "command": "openchoreo.createComponent",
        "title": "Create Component",
        "category": "OpenChoreo",
        "icon": "$(add)"
      },
      {
        "command": "openchoreo.refreshCluster",
        "title": "Refresh Cluster Resources",
        "category": "OpenChoreo",
        "icon": "$(refresh)"
      },
      {
        "command": "openchoreo.addToChat",
        "title": "Add to Chat",
        "category": "OpenChoreo",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "openchoreo.addYamlToChat",
        "title": "Add YAML to Chat",
        "category": "OpenChoreo",
        "icon": "$(code)"
      },
      {
        "command": "openchoreo.generateRelease",
        "title": "Generate Release",
        "category": "OpenChoreo",
        "icon": "$(tag)"
      },
      {
        "command": "openchoreo.triggerBuild",
        "title": "Trigger Build",
        "category": "OpenChoreo",
        "icon": "$(play)"
      },
      {
        "command": "openchoreo.triggerBuildWithParams",
        "title": "Trigger Build with Parameters",
        "category": "OpenChoreo",
        "icon": "$(play)"
      },
      {
        "command": "openchoreo.runWorkflow",
        "title": "Run Workflow",
        "category": "OpenChoreo",
        "icon": "$(play)"
      },
      {
        "command": "openchoreo.promoteBinding",
        "title": "Promote",
        "category": "OpenChoreo",
        "icon": "$(arrow-right)"
      },
      {
        "command": "openchoreo.deployToEnv",
        "title": "Deploy Release...",
        "category": "OpenChoreo",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "openchoreo.deployRelease",
        "title": "Deploy to Environment...",
        "category": "OpenChoreo",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "openchoreo.viewWorkflowRunLogs",
        "title": "View Logs",
        "category": "OpenChoreo",
        "icon": "$(output)"
      },
      {
        "command": "openchoreo.viewWorkflowRunEvents",
        "title": "View Events",
        "category": "OpenChoreo",
        "icon": "$(list-unordered)"
      },
      {
        "command": "openchoreo.viewStepLogs",
        "title": "View Step Logs",
        "category": "OpenChoreo",
        "icon": "$(output)"
      },
      {
        "command": "openchoreo.viewStepEvents",
        "title": "View Step Events",
        "category": "OpenChoreo",
        "icon": "$(list-unordered)"
      },
      {
        "command": "openchoreo.openK8sDefinition",
        "title": "View Definition",
        "category": "OpenChoreo",
        "icon": "$(file-code)"
      },
      {
        "command": "openchoreo.viewK8sResourceLogs",
        "title": "View Pod Logs",
        "category": "OpenChoreo",
        "icon": "$(output)"
      },
      {
        "command": "openchoreo.viewK8sResourceEvents",
        "title": "View Events",
        "category": "OpenChoreo",
        "icon": "$(list-unordered)"
      }
    ],
    "menus": {
      "editor/title": [],
      "view/title": [],
      "webview/context": [
        {
          "command": "openchoreo.createComponent",
          "when": "webviewId == openchoreo.sidebar && nodeType == project && isCreatable",
          "group": "1_create"
        },
        {
          "command": "openchoreo.createChildResource",
          "when": "webviewId == openchoreo.sidebar && nodeType == 'infra-category' && isCreatable",
          "group": "1_create"
        },
        {
          "command": "openchoreo.generateRelease",
          "when": "webviewId == openchoreo.sidebar && nodeType == component && isEditable",
          "group": "1_actions"
        },
        {
          "command": "openchoreo.triggerBuild",
          "when": "webviewId == openchoreo.sidebar && nodeType == component && isEditable",
          "group": "1_actions"
        },
        {
          "command": "openchoreo.triggerBuildWithParams",
          "when": "webviewId == openchoreo.sidebar && nodeType == component && isEditable",
          "group": "1_actions"
        },
        {
          "command": "openchoreo.runWorkflow",
          "when": "webviewId == openchoreo.sidebar && nodeType == workflow && isEditable",
          "group": "1_actions"
        },
        {
          "command": "openchoreo.runWorkflow",
          "when": "webviewId == openchoreo.sidebar && nodeType == 'cluster-workflow' && isEditable",
          "group": "1_actions"
        },
        {
          "command": "openchoreo.openResource",
          "when": "webviewId == openchoreo.sidebar && isEditable",
          "group": "2_open"
        },
        {
          "command": "openchoreo.openK8sDefinition",
          "when": "webviewId == openchoreo.sidebar && nodeType == 'k8s-resource' || webviewId == openchoreo.sidebar && nodeType == 'k8s-pod'",
          "group": "2_open"
        },
        {
          "command": "openchoreo.viewWorkflowRunLogs",
          "when": "webviewId == openchoreo.sidebar && nodeType == 'workflow-run'",
          "group": "2_observe"
        },
        {
          "command": "openchoreo.viewWorkflowRunEvents",
          "when": "webviewId == openchoreo.sidebar && nodeType == 'workflow-run'",
          "group": "2_observe"
        },
        {
          "command": "openchoreo.viewStepLogs",
          "when": "webviewId == openchoreo.sidebar && nodeType == 'workflow-run-step'",
          "group": "2_observe"
        },
        {
          "command": "openchoreo.viewStepEvents",
          "when": "webviewId == openchoreo.sidebar && nodeType == 'workflow-run-step'",
          "group": "2_observe"
        },
        {
          "command": "openchoreo.viewK8sResourceLogs",
          "when": "webviewId == openchoreo.sidebar && nodeType == 'k8s-pod'",
          "group": "2_observe"
        },
        {
          "command": "openchoreo.viewK8sResourceEvents",
          "when": "webviewId == openchoreo.sidebar && nodeType == 'k8s-resource' || webviewId == openchoreo.sidebar && nodeType == 'k8s-pod'",
          "group": "2_observe"
        },
        {
          "command": "openchoreo.promoteBinding",
          "when": "webviewId == openchoreo.sidebar && isPromotable",
          "group": "1_actions"
        },
        {
          "command": "openchoreo.deployToEnv",
          "when": "webviewId == openchoreo.sidebar && isDeployable",
          "group": "1_actions"
        },
        {
          "command": "openchoreo.deployRelease",
          "when": "webviewId == openchoreo.sidebar && nodeType == 'component-release'",
          "group": "1_actions"
        },
        {
          "command": "openchoreo.deleteResource",
          "when": "webviewId == openchoreo.sidebar && isDeletable",
          "group": "3_destructive"
        },
        {
          "command": "openchoreo.addToChat",
          "when": "webviewId == openchoreo.sidebar && nodeType && nodeType != 'no-connection' && nodeType != empty && nodeType != 'component-category' && nodeType != 'infra-category'",
          "group": "4_chat"
        },
        {
          "command": "openchoreo.addYamlToChat",
          "when": "webviewId == openchoreo.sidebar && nodeType && nodeType != 'no-connection' && nodeType != empty && nodeType != 'component-category' && nodeType != 'infra-category'",
          "group": "4_chat"
        }
      ],
      "view/item/context": []
    },
    "configuration": {
      "title": "OpenChoreo",
      "properties": {
        "openchoreo.configPath": {
          "type": "string",
          "default": "",
          "description": "Path to occ CLI config file. Defaults to ~/.openchoreo/config"
        },
        "openchoreo.autoRefresh": {
          "type": "boolean",
          "default": false,
          "description": "Automatically refresh resource tree on changes"
        },
        "openchoreo.autoRefreshInterval": {
          "type": "number",
          "default": 30,
          "description": "Auto-refresh interval in seconds"
        }
      }
    },
    "snippets": []
  },
  "scripts": {
    "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "dev": "pnpm build --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "generate:icons": "fantasticon && node scripts/update-icon-font.mjs",
    "clean": "rm -rf dist out",
    "prepackage": "cp -r ../../schemas ./schemas && mkdir -p ./language-server/dist && cp ../language-server/dist/server.js ./language-server/dist/server.js && mkdir -p ./webview-ui/dist && cp ../webview-ui/dist/* ./webview-ui/dist/",
    "package": "pnpm build && vsce package --no-dependencies --allow-missing-repository --skip-license",
    "postpackage": "rm -rf ./schemas ./language-server ./webview-ui"
  },
  "dependencies": {
    "@openchoreo/openchoreo-client-node": "link:/Users/kavithlokuhewage/git/backstage-plugins/packages/openchoreo-client-node",
    "openapi-fetch": "0.13.8",
    "vscode-languageclient": "^9.0.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "fantasticon": "^4.1.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}

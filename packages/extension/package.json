{
  "name": "openchoreo",
  "displayName": "OpenChoreo",
  "description": "IDE-native tooling for the OpenChoreo developer platform — CRD editing, resource explorer, and platform workflows",
  "version": "0.1.0",
  "publisher": "openchoreo",
  "license": "Apache-2.0",
  "icon": "resources/openchoreo.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "openchoreo",
    "kubernetes",
    "crd",
    "yaml",
    "platform-engineering"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "onFileSystem:openchoreo",
    "onView:openchoreo.resourceExplorer",
    "onView:openchoreo.infrastructureExplorer"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "openchoreo",
        "label": "OpenChoreo"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openchoreo",
          "title": "OpenChoreo",
          "icon": "resources/openchoreo.svg"
        }
      ]
    },
    "views": {
      "openchoreo": [
        {
          "id": "openchoreo.resourceExplorer",
          "name": "Developer Resources"
        },
        {
          "id": "openchoreo.infrastructureExplorer",
          "name": "Platform Resources",
          "visibility": "collapsed"
        },
        {
          "id": "openchoreo.clusterExplorer",
          "name": "Cluster Resources",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "openchoreo.refreshResources",
        "title": "Refresh Resources",
        "category": "OpenChoreo",
        "icon": "$(refresh)"
      },
      {
        "command": "openchoreo.switchContext",
        "title": "Switch Context",
        "category": "OpenChoreo"
      },
      {
        "command": "openchoreo.login",
        "title": "Login (via occ CLI)",
        "category": "OpenChoreo"
      },
      {
        "command": "openchoreo.openResource",
        "title": "Open Resource YAML",
        "category": "OpenChoreo"
      },
      {
        "command": "openchoreo.refreshInfrastructure",
        "title": "Refresh Infrastructure",
        "category": "OpenChoreo",
        "icon": "$(refresh)"
      },
      {
        "command": "openchoreo.deleteResource",
        "title": "Delete",
        "category": "OpenChoreo",
        "icon": "$(trash)"
      },
      {
        "command": "openchoreo.applyResource",
        "title": "Apply Resource to Cluster",
        "category": "OpenChoreo",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "openchoreo.createDevResource",
        "title": "Create Resource",
        "category": "OpenChoreo",
        "icon": "$(add)"
      },
      {
        "command": "openchoreo.createInfraResource",
        "title": "Create Resource",
        "category": "OpenChoreo",
        "icon": "$(add)"
      },
      {
        "command": "openchoreo.createClusterResource",
        "title": "Create Cluster Resource",
        "category": "OpenChoreo",
        "icon": "$(add)"
      },
      {
        "command": "openchoreo.selectNamespace",
        "title": "Select Namespace",
        "category": "OpenChoreo",
        "icon": "$(organization)"
      },
      {
        "command": "openchoreo.createChildResource",
        "title": "Create",
        "category": "OpenChoreo",
        "icon": "$(add)"
      },
      {
        "command": "openchoreo.createComponent",
        "title": "Create Component",
        "category": "OpenChoreo",
        "icon": "$(add)"
      },
      {
        "command": "openchoreo.refreshCluster",
        "title": "Refresh Cluster Resources",
        "category": "OpenChoreo",
        "icon": "$(refresh)"
      },
      {
        "command": "openchoreo.addToChat",
        "title": "Add to Chat",
        "category": "OpenChoreo",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "openchoreo.addYamlToChat",
        "title": "Add YAML to Chat",
        "category": "OpenChoreo",
        "icon": "$(code)"
      },
      {
        "command": "openchoreo.generateRelease",
        "title": "Generate Release",
        "category": "OpenChoreo",
        "icon": "$(tag)"
      },
      {
        "command": "openchoreo.triggerBuild",
        "title": "Trigger Build",
        "category": "OpenChoreo",
        "icon": "$(play)"
      },
      {
        "command": "openchoreo.viewWorkflowRunLogs",
        "title": "View Logs",
        "category": "OpenChoreo",
        "icon": "$(output)"
      },
      {
        "command": "openchoreo.viewWorkflowRunEvents",
        "title": "View Events",
        "category": "OpenChoreo",
        "icon": "$(list-unordered)"
      },
      {
        "command": "openchoreo.viewStepLogs",
        "title": "View Step Logs",
        "category": "OpenChoreo",
        "icon": "$(output)"
      },
      {
        "command": "openchoreo.viewStepEvents",
        "title": "View Step Events",
        "category": "OpenChoreo",
        "icon": "$(list-unordered)"
      },
      {
        "command": "openchoreo.openK8sDefinition",
        "title": "View Definition",
        "category": "OpenChoreo",
        "icon": "$(file-code)"
      },
      {
        "command": "openchoreo.viewK8sResourceLogs",
        "title": "View Pod Logs",
        "category": "OpenChoreo",
        "icon": "$(output)"
      },
      {
        "command": "openchoreo.viewK8sResourceEvents",
        "title": "View Events",
        "category": "OpenChoreo",
        "icon": "$(list-unordered)"
      }
    ],
    "menus": {
      "editor/title": [],
      "view/title": [
        {
          "command": "openchoreo.selectNamespace",
          "when": "view == openchoreo.resourceExplorer",
          "group": "navigation"
        },
        {
          "command": "openchoreo.refreshResources",
          "when": "view == openchoreo.resourceExplorer",
          "group": "navigation"
        },
        {
          "command": "openchoreo.createDevResource",
          "when": "view == openchoreo.resourceExplorer",
          "group": "navigation"
        },
        {
          "command": "openchoreo.selectNamespace",
          "when": "view == openchoreo.infrastructureExplorer",
          "group": "navigation"
        },
        {
          "command": "openchoreo.refreshInfrastructure",
          "when": "view == openchoreo.infrastructureExplorer",
          "group": "navigation"
        },
        {
          "command": "openchoreo.createInfraResource",
          "when": "view == openchoreo.infrastructureExplorer",
          "group": "navigation"
        },
        {
          "command": "openchoreo.refreshCluster",
          "when": "view == openchoreo.clusterExplorer",
          "group": "navigation"
        },
        {
          "command": "openchoreo.createClusterResource",
          "when": "view == openchoreo.clusterExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "openchoreo.createComponent",
          "when": "viewItem =~ /^project.*_creatable/",
          "group": "inline"
        },
        {
          "command": "openchoreo.createComponent",
          "when": "viewItem =~ /^project.*_creatable/",
          "group": "1_create"
        },
        {
          "command": "openchoreo.createChildResource",
          "when": "viewItem =~ /^infra-category_creatable/",
          "group": "inline"
        },
        {
          "command": "openchoreo.createChildResource",
          "when": "viewItem =~ /^infra-category_creatable/",
          "group": "1_create"
        },
        {
          "command": "openchoreo.openResource",
          "when": "viewItem =~ /^(project|component|environment|workflow|trait|workload|release-binding|deployment-pipeline|secret-reference)(_editable)?(_deletable)?(_creatable)?$/",
          "group": "2_open"
        },
        {
          "command": "openchoreo.deleteResource",
          "when": "viewItem =~ /_deletable/",
          "group": "3_destructive"
        },
        {
          "command": "openchoreo.generateRelease",
          "when": "viewItem =~ /^component_editable/",
          "group": "1_actions"
        },
        {
          "command": "openchoreo.triggerBuild",
          "when": "viewItem =~ /^component_editable/",
          "group": "1_actions"
        },
        {
          "command": "openchoreo.viewWorkflowRunLogs",
          "when": "viewItem == workflow-run",
          "group": "2_observe"
        },
        {
          "command": "openchoreo.viewWorkflowRunEvents",
          "when": "viewItem == workflow-run",
          "group": "2_observe"
        },
        {
          "command": "openchoreo.viewStepLogs",
          "when": "viewItem == workflow-run-step",
          "group": "2_observe"
        },
        {
          "command": "openchoreo.viewStepEvents",
          "when": "viewItem == workflow-run-step",
          "group": "2_observe"
        },
        {
          "command": "openchoreo.openK8sDefinition",
          "when": "viewItem =~ /^k8s-resource|^k8s-pod/",
          "group": "2_open"
        },
        {
          "command": "openchoreo.viewK8sResourceLogs",
          "when": "viewItem =~ /^k8s-pod/",
          "group": "2_observe"
        },
        {
          "command": "openchoreo.viewK8sResourceEvents",
          "when": "viewItem =~ /^k8s-resource|^k8s-pod/",
          "group": "2_observe"
        },
        {
          "command": "openchoreo.addToChat",
          "when": "viewItem =~ /^(project|component|environment|workflow|trait|workload|deployment-pipeline|data-plane|workflow-plane|observability-plane|component-type|secret-reference|release-binding|workflow-run|component-release|cluster-component-type|cluster-workflow|cluster-trait|cluster-data-plane|cluster-workflow-plane|cluster-observability-plane)/",
          "group": "4_chat"
        },
        {
          "command": "openchoreo.addYamlToChat",
          "when": "viewItem =~ /^(project|component|environment|workflow|trait|workload|deployment-pipeline|data-plane|workflow-plane|observability-plane|component-type|secret-reference|release-binding|workflow-run|component-release|cluster-component-type|cluster-workflow|cluster-trait|cluster-data-plane|cluster-workflow-plane|cluster-observability-plane)/",
          "group": "4_chat"
        }
      ]
    },
    "configuration": {
      "title": "OpenChoreo",
      "properties": {
        "openchoreo.configPath": {
          "type": "string",
          "default": "",
          "description": "Path to occ CLI config file. Defaults to ~/.openchoreo/config"
        },
        "openchoreo.autoRefresh": {
          "type": "boolean",
          "default": false,
          "description": "Automatically refresh resource tree on changes"
        },
        "openchoreo.autoRefreshInterval": {
          "type": "number",
          "default": 30,
          "description": "Auto-refresh interval in seconds"
        }
      }
    },
    "snippets": []
  },
  "scripts": {
    "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "dev": "pnpm build --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist out",
    "prepackage": "cp -r ../../schemas ./schemas && mkdir -p ./language-server/dist && cp ../language-server/dist/server.js ./language-server/dist/server.js",
    "package": "pnpm build && vsce package --no-dependencies --allow-missing-repository --skip-license",
    "postpackage": "rm -rf ./schemas ./language-server"
  },
  "dependencies": {
    "@openchoreo/openchoreo-client-node": "link:/Users/kavithlokuhewage/git/backstage-plugins/packages/openchoreo-client-node",
    "openapi-fetch": "0.13.8",
    "vscode-languageclient": "^9.0.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "@vscode/vsce": "^3.2.0"
  }
}

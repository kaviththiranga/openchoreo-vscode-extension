{
  "name": "openchoreo",
  "displayName": "OpenChoreo",
  "description": "IDE-native tooling for the OpenChoreo developer platform — CRD editing, resource explorer, and platform workflows",
  "version": "0.1.0",
  "publisher": "openchoreo",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "openchoreo",
    "kubernetes",
    "crd",
    "yaml",
    "platform-engineering"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "onFileSystem:openchoreo",
    "onView:openchoreo.resourceExplorer",
    "onView:openchoreo.infrastructureExplorer"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "openchoreo",
        "fullName": "OpenChoreo",
        "name": "openchoreo",
        "description": "OpenChoreo platform — ask about resources, deployments, builds, observability",
        "isSticky": true
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "openchoreo",
        "label": "OpenChoreo"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openchoreo",
          "title": "OpenChoreo",
          "icon": "resources/openchoreo.svg"
        }
      ]
    },
    "views": {
      "openchoreo": [
        {
          "id": "openchoreo.resourceExplorer",
          "name": "Developer Resources"
        },
        {
          "id": "openchoreo.infrastructureExplorer",
          "name": "Platform Resources",
          "visibility": "collapsed"
        },
        {
          "id": "openchoreo.clusterExplorer",
          "name": "Cluster Resources",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "openchoreo.refreshResources",
        "title": "Refresh Resources",
        "category": "OpenChoreo",
        "icon": "$(refresh)"
      },
      {
        "command": "openchoreo.switchContext",
        "title": "Switch Context",
        "category": "OpenChoreo"
      },
      {
        "command": "openchoreo.login",
        "title": "Login (via occ CLI)",
        "category": "OpenChoreo"
      },
      {
        "command": "openchoreo.openResource",
        "title": "Open Resource YAML",
        "category": "OpenChoreo"
      },
      {
        "command": "openchoreo.refreshInfrastructure",
        "title": "Refresh Infrastructure",
        "category": "OpenChoreo",
        "icon": "$(refresh)"
      },
      {
        "command": "openchoreo.deleteResource",
        "title": "Delete",
        "category": "OpenChoreo",
        "icon": "$(trash)"
      },
      {
        "command": "openchoreo.applyResource",
        "title": "Apply Resource to Cluster",
        "category": "OpenChoreo",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "openchoreo.createResource",
        "title": "Create New Resource",
        "category": "OpenChoreo",
        "icon": "$(add)"
      },
      {
        "command": "openchoreo.selectNamespace",
        "title": "Select Namespace",
        "category": "OpenChoreo",
        "icon": "$(organization)"
      },
      {
        "command": "openchoreo.createChildResource",
        "title": "Create",
        "category": "OpenChoreo",
        "icon": "$(add)"
      },
      {
        "command": "openchoreo.refreshCluster",
        "title": "Refresh Cluster Resources",
        "category": "OpenChoreo",
        "icon": "$(refresh)"
      },
      {
        "command": "openchoreo.addToChat",
        "title": "Add to Chat",
        "category": "OpenChoreo",
        "icon": "$(comment-discussion)"
      }
    ],
    "menus": {
      "editor/title": [],
      "view/title": [
        {
          "command": "openchoreo.selectNamespace",
          "when": "view == openchoreo.resourceExplorer",
          "group": "navigation"
        },
        {
          "command": "openchoreo.refreshResources",
          "when": "view == openchoreo.resourceExplorer",
          "group": "navigation"
        },
        {
          "command": "openchoreo.createResource",
          "when": "view == openchoreo.resourceExplorer",
          "group": "navigation"
        },
        {
          "command": "openchoreo.selectNamespace",
          "when": "view == openchoreo.infrastructureExplorer",
          "group": "navigation"
        },
        {
          "command": "openchoreo.refreshInfrastructure",
          "when": "view == openchoreo.infrastructureExplorer",
          "group": "navigation"
        },
        {
          "command": "openchoreo.createResource",
          "when": "view == openchoreo.infrastructureExplorer",
          "group": "navigation"
        },
        {
          "command": "openchoreo.refreshCluster",
          "when": "view == openchoreo.clusterExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "openchoreo.createChildResource",
          "when": "viewItem =~ /_creatable/",
          "group": "inline"
        },
        {
          "command": "openchoreo.createChildResource",
          "when": "viewItem =~ /_creatable/",
          "group": "1_create"
        },
        {
          "command": "openchoreo.openResource",
          "when": "viewItem =~ /^(project|component|environment|workflow|trait|workload|release-binding|deployment-pipeline|secret-reference)(_editable)?(_deletable)?(_creatable)?$/",
          "group": "2_open"
        },
        {
          "command": "openchoreo.deleteResource",
          "when": "viewItem =~ /_deletable/",
          "group": "3_destructive"
        },
        {
          "command": "openchoreo.addToChat",
          "when": "viewItem =~ /^(project|component|environment|workflow|trait|workload|deployment-pipeline|data-plane|workflow-plane|observability-plane|component-type|secret-reference|release-binding|workflow-run|component-release|cluster-component-type|cluster-workflow|cluster-trait|cluster-data-plane|cluster-workflow-plane|cluster-observability-plane)/",
          "group": "4_chat"
        }
      ]
    },
    "configuration": {
      "title": "OpenChoreo",
      "properties": {
        "openchoreo.configPath": {
          "type": "string",
          "default": "",
          "description": "Path to occ CLI config file. Defaults to ~/.openchoreo/config"
        },
        "openchoreo.autoRefresh": {
          "type": "boolean",
          "default": false,
          "description": "Automatically refresh resource tree on changes"
        },
        "openchoreo.autoRefreshInterval": {
          "type": "number",
          "default": 30,
          "description": "Auto-refresh interval in seconds"
        }
      }
    },
    "snippets": []
  },
  "scripts": {
    "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "dev": "pnpm build --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist out",
    "prepackage": "cp -r ../../schemas ./schemas",
    "package": "pnpm build && vsce package --no-dependencies",
    "postpackage": "rm -rf ./schemas"
  },
  "dependencies": {
    "@openchoreo/openchoreo-client-node": "link:/Users/kavithlokuhewage/git/backstage-plugins/packages/openchoreo-client-node",
    "openapi-fetch": "0.13.8",
    "vscode-languageclient": "^9.0.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "@vscode/vsce": "^3.2.0"
  }
}
